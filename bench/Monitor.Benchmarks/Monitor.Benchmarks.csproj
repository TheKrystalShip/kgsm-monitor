<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>Monitor.Benchmarks</AssemblyName>
    <RootNamespace>TheKrystalShip.KGSM.Monitor.Benchmarks</RootNamespace>
    <!-- BenchmarkDotNet requires optimized, non-debug builds. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Monitor/Monitor.csproj" />
  </ItemGroup>

  <!-- Inherited via Monitor's Microsoft.Data.Sqlite; see Monitor.csproj for the rationale. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

</Project>
