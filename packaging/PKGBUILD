# Maintainer: Cristian Moraru <info@thekrystalship.com>
#
# Build from this directory:  cd packaging && makepkg
#
# Compiles nothing. CI publishes the Native-AOT binary first and this places the result, so the
# packaged bytes are the tested bytes. Point KGSM_STAGE at that publish output, or leave it unset
# to use ../artifacts/publish, which is where deploy.sh leaves one.
#
# Two packages from one build:
#   kgsm-monitor            the daemon — unprivileged, and the whole product on a host without eBPF
#   kgsm-monitor-net-meter  the eBPF per-server network meter — root-owned, optional

pkgbase=kgsm-monitor
pkgname=('kgsm-monitor' 'kgsm-monitor-net-meter')
pkgver=2.12.0
pkgrel=1
arch=('x86_64')
url="https://github.com/TheKrystalShip/kgsm-monitor"
license=('GPL-3.0-or-later')
# No separate debug package: these are shipped to a private fleet, not a distro archive.
options=('!debug')

_stage() { printf '%s' "${KGSM_STAGE:-${startdir}/../artifacts/publish}"; }

pkgver() {
    "${startdir}/../deploy/version.sh" --pkgver
}

build() {
    local stage repo; stage="$(_stage)"; repo="${startdir}/.."
    [[ -f "${stage}/kgsm-monitor" ]] || {
        printf '\n  no publish output at %s\n' "$stage" >&2
        printf '  build it first:  dotnet publish src/Monitor/Monitor.csproj -c Release -r linux-x64 -o artifacts/publish\n' >&2
        printf '  or point KGSM_STAGE at an existing one.\n\n' >&2
        return 1
    }

    # The eBPF object, compiled here when the stage does not already carry one. It is what keeps
    # clang off every node: without it net-meter-setup.sh falls back to compiling on the host, and
    # the node needs a compiler the package never declared. Compiling on the packaging machine —
    # this one or a CI runner — produces the same object either way, because the program is
    # deliberately not CO-RE: it touches only the uapi struct __sk_buff, needs no vmlinux.h, and one
    # object loads on any node's kernel. -g emits the BTF the typed map needs.
    if [[ ! -f "${stage}/net_meter.bpf.o" ]] && command -v clang >/dev/null; then
        clang -O2 -g -target bpf -c "${repo}/src/Monitor/bpf/net_meter.bpf.c" -o net_meter.bpf.o
        file net_meter.bpf.o | grep -q eBPF
    fi
}

package_kgsm-monitor() {
    pkgdesc="KGSM host and per-server metrics daemon"
    groups=('kgsm-node')
    # kgsm-base carries the kgsm service account this unit runs as, the /var/lib/kgsm tree it reads
    # the leaf descriptors and journals from, and the preset policy deciding whether it runs here.
    depends=('kgsm-base' 'systemd')
    backup=('etc/kgsm-monitor/kgsm-monitor.env')
    install="kgsm-monitor.install"
    optdepends=(
        'kgsm: lists instances, which is what gives per-server metrics a watch-list'
        'kgsm-watchdog: owns kgsm.slice, where native servers live'
        'kgsm-monitor-net-meter: per-server network rx/tx (without it those fields read null)'
        'docker: sampling container-kind servers'
    )

    local repo="${startdir}/.." stage; stage="$(_stage)"
    local prefix="${pkgdir}/opt/${pkgbase}"

    # The AOT binary, its native sqlite lib and the settings file, exactly as published.
    install -dm755 "$prefix"
    cp -a "${stage}/." "${prefix}/"
    # A published tree carries build leftovers that a package should not.
    rm -f "${prefix}"/*.pdb "${prefix}"/*.dbg
    # The eBPF object belongs to kgsm-monitor-net-meter, which installs it to this same prefix. The
    # build stage holds it because CI compiles it there; leaving it here makes two packages own one
    # file, which pacman refuses — and since net-meter depends on this package, that would make it
    # uninstallable rather than merely conflicting.
    rm -f "${prefix}/net_meter.bpf.o"

    install -Dm644 "${repo}/deploy/kgsm-monitor.service" \
        "${pkgdir}/usr/lib/systemd/system/kgsm-monitor.service"

    # Operator overrides. Seeded from the committed example — every knob commented — and listed in
    # backup=(), so an upgrade writes .pacnew beside an edited file rather than over it. Root-owned
    # 0640 is correct rather than strict: systemd reads EnvironmentFile= as root before dropping to
    # User=, so nothing reads this as the service account.
    install -Dm640 "${repo}/deploy/kgsm-monitor.env.example" \
        "${pkgdir}/etc/${pkgname}/${pkgname}.env"

    # The leaf config descriptor, in the directory kgsm-api scans. Packaged rather than installed by
    # a script, so it can never describe a different build than the one beside it.
    install -Dm644 "${repo}/deploy/kgsm-monitor.leaf.json" \
        "${pkgdir}/var/lib/kgsm/leaves/monitor.json"

    install -Dm644 "${repo}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

package_kgsm-monitor-net-meter() {
    pkgdesc="KGSM per-server network meter — eBPF cgroup/skb byte counter for kgsm-monitor"
    arch=('any')   # a script plus an eBPF object; nothing here is x86_64-specific
    # On the selection menu: it is preset-enabled and is what makes per-server rxBps/txBps a
    # measurement rather than a null, so a node choosing the monitor is offered it in the same list.
    groups=('kgsm-node')
    depends=('kgsm-base' 'kgsm-monitor' 'bpf')
    optdepends=('kgsm-watchdog: owns kgsm.slice, the cgroup the meter attaches to')
    install="kgsm-monitor-net-meter.install"

    local repo="${startdir}/.." stage; stage="$(_stage)"

    # Root-owned, both of them: the script loads and attaches BPF as root, and a root-executed file
    # an unprivileged user can rewrite is an escalation path. Same reason kgsm-firewall keeps the
    # classic layout.
    install -Dm755 "${repo}/deploy/net-meter-setup.sh" \
        "${pkgdir}/opt/${pkgbase}/net-meter-setup.sh"
    install -Dm644 "${repo}/deploy/kgsm-net-meter.service" \
        "${pkgdir}/usr/lib/systemd/system/kgsm-net-meter.service"

    # The prebuilt eBPF object, so no node ever needs a compiler. The program is deliberately not
    # CO-RE — it touches only the uapi struct __sk_buff and needs no vmlinux.h — so one object built
    # anywhere loads on any node's kernel.
    if [[ -f "${stage}/net_meter.bpf.o" ]]; then
        install -Dm644 "${stage}/net_meter.bpf.o" "${pkgdir}/opt/${pkgbase}/net_meter.bpf.o"
    elif [[ -f "${srcdir}/net_meter.bpf.o" ]]; then
        install -Dm644 "${srcdir}/net_meter.bpf.o" "${pkgdir}/opt/${pkgbase}/net_meter.bpf.o"
    elif [[ -f "${repo}/src/Monitor/bpf/net_meter.bpf.o" ]]; then
        install -Dm644 "${repo}/src/Monitor/bpf/net_meter.bpf.o" "${pkgdir}/opt/${pkgbase}/net_meter.bpf.o"
    else
        # Reached only on a packaging machine with no clang and a stage that carries no object.
        # Without one the setup script falls back to compiling on the node, which makes clang a
        # runtime dependency this package never declared — so warn loudly rather than ship that
        # quietly, and carry the source so the fallback has something to compile.
        warning "no net_meter.bpf.o and no clang — the installed meter will need clang on the host"
        install -Dm644 "${repo}/src/Monitor/bpf/net_meter.bpf.c" \
            "${pkgdir}/opt/${pkgbase}/net_meter.bpf.c"
    fi
    install -Dm644 "${repo}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

}
