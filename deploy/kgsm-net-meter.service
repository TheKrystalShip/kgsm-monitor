[Unit]
Description=KGSM per-server network meter (eBPF cgroup/skb counter) setup
Documentation=https://github.com/TheKrystalShip
# The meter attaches to the kgsm.slice cgroup, which kgsm-watchdog owns/creates. Order
# AFTER the watchdog so the slice exists when we attach. PartOf= makes systemd re-run this
# oneshot whenever the watchdog (re)starts, so a slice teardown/recreate re-establishes the
# attach. (We attach to kgsm.slice, the STABLE parent — not the per-restart watchdog service
# cgroup — so in practice a watchdog restart leaves the attach intact and this is a cheap
# re-affirm; the PartOf still covers the rare full-slice recreation.)
After=kgsm-watchdog.service
PartOf=kgsm-watchdog.service

[Service]
Type=oneshot
# RemainAfterExit so systemctl reports the meter as "active (exited)" once setup succeeds,
# and so PartOf= stop/restart semantics track it as a unit of the watchdog.
RemainAfterExit=yes

# Must run as root: load/attach BPF, set bpffs perms. This is the ONE privileged piece of the
# per-server-network feature; the monitor itself runs unprivileged and reads the pinned map with
# AmbientCapabilities=CAP_BPF. The script is installed beside the binary by deploy.sh and accepts
# KGSM_BPF_DIR / KGSM_SLICE / KGSM_MONITOR_BIN / KGSM_MONITOR_USER overrides (see its header).
ExecStart=/opt/kgsm-monitor/net-meter-setup.sh

[Install]
# Two wants, because they answer different questions. multi-user covers a boot with no watchdog
# yet. kgsm-watchdog covers every later start of the watchdog: PartOf= above propagates its STOP
# and its restart, but never its start, so without this a stop followed by a separate start
# leaves the meter down until the next reboot — and a kgsm.slice that was torn down and recreated
# in between has no programs attached to it.
WantedBy=multi-user.target kgsm-watchdog.service
