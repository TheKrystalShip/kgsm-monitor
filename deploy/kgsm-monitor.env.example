# kgsm-monitor — configuration (systemd EnvironmentFile format: KEY=VALUE, # comments).
#
# Lives at /etc/kgsm-monitor/kgsm-monitor.env. The unit reads it with EnvironmentFile=-, so an
# absent file is not an error and every knob below keeps the default shown in [brackets].
#
# kgsm-monitor.settings.json, installed beside the binary, declares every knob with its default.
# A variable here overrides ONE key of that file, spelling its path with "__". A variable naming a
# key the file does not declare binds to nothing and sets nothing, so check the spelling against
# that file rather than against this one.
#
# This file is read AFTER the unit's own Environment= lines, so anything uncommented here wins over
# the unit — including the four knobs the unit sets (SocketPath, SocketMode, KgsmPath,
# KgsmJournalDir). Uncomment a line only to override it.

# ── Sampling ──────────────────────────────────────────────────────────────────
# How often host and per-server metrics are sampled, ms. Floor 100.       [1000]
#Monitor__IntervalMs=1000

# ── The metrics socket (filesystem perms are the security boundary) ───────────
# Unix socket the monitor serves /metrics on — the socket kgsm-api scrapes.
# Set by the unit; a co-located API must be pointed at the same path.
#                                            [/run/kgsm-monitor/metrics.sock]
#Monitor__SocketPath=/run/kgsm-monitor/metrics.sock
# Octal perms applied to the socket (owner+group rw).                      [660]
#Monitor__SocketMode=660

# ── What to leave out of the host figures ─────────────────────────────────────
# Extra filesystem types to hide from the mount list, comma-separated, on top of
# the always-filtered pseudo filesystems.                            [] (none)
#Monitor__MountFsDeny=

# Interface-name prefixes excluded from host network rates, comma-separated, on
# top of the always-excluded loopback. veth pairs are per-container noise that
# double-counts container traffic in the host aggregate; docker and br- are the
# common additions.                                                     [veth]
#Monitor__IfaceDenyPrefixes=veth

# ── KGSM integration (what gives per-server metrics a watch-list) ─────────────
# Absolute path to the kgsm entry point. EMPTY disables per-server sampling and
# the monitor runs host-only, which is why it needs no engine at all. The unit
# sets the packaged path.                                                    []
#Monitor__KgsmPath=/usr/bin/kgsm

# The engine's append-only event journal, tailed for instance_* lifecycle events
# so a started or stopped server is reflected sub-second. Read-only and shared —
# the engine is the sole writer.                       [/var/lib/kgsm/events]
#Monitor__KgsmJournalDir=/var/lib/kgsm/events

# How often the instance list is re-read from the engine, ms. Floor 1000. This
# spawns a process, so it stays well off the metrics tick and remains the
# watch-list's source of truth.                                        [15000]
#Monitor__ServerResyncMs=15000

# Whether lifecycle events are read from the journal for low-latency watch-list
# deltas. Off still gives per-server metrics — the resync floor covers it — and
# costs engine event history.                                            [true]
#Monitor__EventsEnabled=true

# How often each server's on-disk footprint is recomputed, ms. Floor 5000. A
# recursive walk of the instance's working dir, far heavier than the cgroup
# reads, so it runs on its own slow cadence.                            [60000]
#Monitor__DiskUsageMs=60000

# ── The ecosystem's own leaves, measured alongside the game servers ──────────
# Set true to stop sampling the leaf daemons. Sampling them needs no privilege,
# no engine and no other leaf.                                          [false]
#Monitor__LeafMetricsDisabled=false

# Directory holding the leaf config descriptors — where the leaf watch-list comes
# from. Read-only and shared with every leaf's deploy and with kgsm-api.
#                                                      [/var/lib/kgsm/leaves]
#Monitor__LeafDescriptorDir=/var/lib/kgsm/leaves

# How often it is re-resolved which leaves run and in which cgroup, ms.
# Floor 1000. This spawns systemctl.                                    [30000]
#Monitor__LeafResolveMs=30000

# The systemctl binary used to read each leaf unit's main pid. Resolved via PATH;
# give an absolute path where PATH cannot be relied on.             [systemctl]
#Monitor__SystemctlPath=systemctl

# ── History (the SQLite store behind /metrics/history) ───────────────────────
# Identity this host's host-kind rows are stored under. Empty resolves to the
# machine name, the same default kgsm-api uses for its own host id — set both to
# the same value when overriding, or the api's history queries miss the rows.
#                                                        [] (the machine name)
#Monitor__HostId=

# Set true to run live-only: no persist loop, no maintenance, no
# /metrics/history endpoint.                                            [false]
#Monitor__HistoryDisabled=false

# SQLite file for the history store. Under the systemd StateDirectory, which is
# persistent — NOT the tmpfs runtime dir where the socket lives.
#                                             [/var/lib/kgsm-monitor/metrics.db]
#Monitor__HistoryDbPath=/var/lib/kgsm-monitor/metrics.db

# How often the latest frame is flushed to history, ms. Floor 1000.     [15000]
#Monitor__PersistMs=15000

# Raw-tier retention, hours. Floor 1. Also the tier-select boundary: a query
# range at or under this reads raw, above it reads rollup.                 [24]
#Monitor__RawRetentionHours=24

# Rollup bucket width, minutes. Floor 1.                                    [5]
#Monitor__RollupStepMin=5

# Rollup-tier retention, days. Floor 1.                                    [30]
#Monitor__RollupRetentionDays=30

# How often maintenance (rollup + prune + vacuum) runs, ms. Floor 1000. [60000]
#Monitor__MaintenanceMs=60000

# ── Footprint and thresholds ─────────────────────────────────────────────────
# Set true to stop accumulating the per-instance memory footprint and to leave
# /footprint unwired. A later reader then finds no record rather than a short
# one.                                                                  [false]
#Monitor__FootprintDisabled=false

# Set true to wire no threshold evaluator. Every frame then carries an empty
# conditions array, and a consumer shows nothing rather than all-clear — "not
# being watched" and "nothing wrong" are different answers.             [false]
#Monitor__ThresholdsDisabled=false

# File the applied threshold policy is persisted to. Beside the history database
# but deliberately not inside it, so the policy survives HistoryDisabled=true.
#                                          [/var/lib/kgsm-monitor/thresholds.json]
#Monitor__ThresholdPolicyPath=/var/lib/kgsm-monitor/thresholds.json

# ── Logging ──────────────────────────────────────────────────────────────────
# Default log level: Trace, Debug, Information, Warning, Error, Critical, None.
#                                                              [Information]
#Logging__LogLevel__Default=Information
