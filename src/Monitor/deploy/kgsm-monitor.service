[Unit]
Description=KGSM Metrics Monitor
Documentation=https://github.com/TheKrystalShip
After=network.target

[Service]
Type=simple
# Native-AOT single-file binary. Runs as root so it can read /proc/<pid>/io and
# every cgroup under system.slice (per-server metrics in Slice 2+).
ExecStart=/opt/kgsm-monitor/kgsm-monitor

# Configuration (all optional — these are the defaults made explicit).
Environment=KGSM_MONITOR_SOCKET=/run/kgsm-monitor/metrics.sock
Environment=KGSM_MONITOR_SOCKET_MODE=660
# Environment=KGSM_MONITOR_INTERVAL_MS=1000
# Environment=KGSM_MONITOR_IFACE_DENY=veth,docker,br-
# Environment=KGSM_MONITOR_MOUNT_FS_DENY=

# Per-server metrics (Slice 2): point at kgsm.sh to enable cgroup sampling of running
# instances. Unset = host-only. Use a path OUTSIDE /home (ProtectHome=true below hides
# /home); the packaged launcher at /usr/local/bin/kgsm is the right target.
# Environment=KGSM_MONITOR_KGSM_PATH=/usr/local/bin/kgsm
# Environment=KGSM_MONITOR_KGSM_SOCKET=/run/kgsm-monitor/monitoring.sock
# Environment=KGSM_MONITOR_RESYNC_MS=15000
#
# Slice 2b — event-driven watch-list delta. The monitor BINDS KGSM_MONITOR_KGSM_SOCKET and
# KGSM connects to it (via `socat`) to push instance lifecycle events, so a started/stopped/
# removed server is reflected sub-second instead of waiting up to RESYNC_MS. The periodic
# resync stays the source of truth, so this is purely a latency win. Set KGSM_MONITOR_EVENTS=0
# to bind no event socket and run resync-only (default is on whenever KGSM_MONITOR_KGSM_PATH
# is set).
# Environment=KGSM_MONITOR_EVENTS=1
#
# KGSM creates/addresses all event sockets under $KGSM_ROOT, so the monitor must bind the
# SAME absolute path KGSM will connect to — point KGSM_MONITOR_KGSM_SOCKET at
# $KGSM_ROOT/monitoring.sock (a dir both this unit and KGSM can reach; mind ProtectHome
# below if $KGSM_ROOT is under /home). Then, in KGSM's config (config.ini), enable the
# Unix-socket transport and add the monitor's filename to the broadcast list:
#   enable_socket_events=true
#   event_socket_filenames=kgsm.sock,monitoring.sock      # (or: kgsm.sh events socket enable)
# Requires `socat` on the host. A non-binding event socket is silent — metrics still flow
# via resync, so absence of fresh resyncs after an instance op is the only symptom (PLAN §12).
#
# Per-server disk-IO is opt-in: io.stat only exists when the io controller is accounted
# for the server's cgroup. To get ioReadBps/ioWriteBps instead of null, set
# `IOAccounting=yes` on each KGSM *game-server* unit (not this one) — e.g. a drop-in
#   [Service]
#   IOAccounting=yes
# CPU/memory/pids need no such flag (always accounted under cgroup v2).

# systemd creates /run/kgsm-monitor (owned root:<group>, traversable by the group).
RuntimeDirectory=kgsm-monitor
RuntimeDirectoryMode=0750

# To let a non-root KGSM API scrape the socket: create a shared group (e.g. `kgsm`),
# add the API's user to it, and uncomment the line below. The daemon keeps uid 0
# (root powers for /proc + cgroups) but the socket is created group=kgsm, mode 0660,
# so any group member can read it. Left commented so the unit starts without the group.
# SupplementaryGroups=kgsm
# Group=kgsm

Restart=always
RestartSec=2

# Hardening — the daemon only reads /proc, /sys and (later) cgroups, and writes one
# unix socket under its RuntimeDirectory. /proc and /sys stay readable under all of these.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
