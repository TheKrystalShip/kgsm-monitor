[Unit]
Description=KGSM Metrics Monitor
Documentation=https://github.com/TheKrystalShip
After=network.target

[Service]
Type=simple
# Runs as the KGSM user, NOT root. The monitor only READS: cgroup v2 counters (the
# per-instance cgroups under kgsm.slice are world-readable; kgsm-watchdog — the peer —
# OWNS and creates them), this user's /proc, and /sys. It also spawns kgsm.sh, which MUST
# run as the KGSM user to enumerate that user's instances. uid/gid 1000 = the KGSM user,
# matching kgsm-watchdog's KGSM_WATCHDOG_UID/GID. Adjust both lines for a different host.
User=heisen
Group=heisen

# Native-AOT single-file binary (publish: dotnet publish src/Monitor -c Release -r linux-x64).
ExecStart=/opt/kgsm-monitor/kgsm-monitor

# The scrape socket the API reads. Lives inside the RuntimeDirectory (below), created by
# systemd owned by this user, so a co-located API running as the same user can read it.
Environment=KGSM_MONITOR_SOCKET=/run/kgsm-monitor/metrics.sock
Environment=KGSM_MONITOR_SOCKET_MODE=660

# Per-server sampling ON: point at the CANONICAL kgsm.sh. The dev checkout under /home is
# authoritative on this host (kgsm-watchdog points at the same path; /usr/local/bin/kgsm is
# the stale old version). Unset this to run host-only. ProtectHome is deliberately NOT set —
# kgsm.sh and its config live under /home and the daemon runs as that home's user.
Environment=KGSM_MONITOR_KGSM_PATH=/home/heisen/tks/kgsm/kgsm.sh

# Event socket the monitor BINDS for low-latency watch-list deltas (Slice 2b). kgsm connects
# to it (via socat) to push instance_* lifecycle events so a started/stopped server is
# reflected sub-second instead of after KGSM_MONITOR_RESYNC_MS. The periodic resync stays the
# source of truth, so this is purely a latency win. To use it, add this filename to kgsm's
# config (enable_socket_events=true, event_socket_filenames=...,monitoring.sock).
Environment=KGSM_MONITOR_KGSM_SOCKET=/run/kgsm-monitor/monitoring.sock

# Per-server disk footprint (diskBytes): recompute cadence for the working-dir size walk.
# Default 60s; lower it for snappier footprint updates during testing.
# Environment=KGSM_MONITOR_DISK_USAGE_MS=60000

# Host-specific overrides (signing keys, alternate paths, etc.) — optional, wins over the above.
EnvironmentFile=-/etc/kgsm-monitor/kgsm-monitor.env

# systemd creates /run/kgsm-monitor owned by this user (mode 0750); the 0660 socket lives in it.
RuntimeDirectory=kgsm-monitor
RuntimeDirectoryMode=0750

Restart=always
RestartSec=2

# Hardening kept minimal/compatible: the daemon reads /proc, /sys, /sys/fs/cgroup and /home
# (kgsm.sh + instance config) and writes only its RuntimeDirectory socket. ProtectHome/
# ProtectSystem=strict are intentionally omitted — they'd hide or freeze the /home paths
# kgsm.sh needs. AF_UNIX is the only socket family it uses.
NoNewPrivileges=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
