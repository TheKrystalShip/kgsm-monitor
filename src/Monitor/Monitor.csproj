<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Native AOT: small footprint, no JIT, instant start — the daemon must not
         steal resources from the game servers it watches. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>

    <RootNamespace>TheKrystalShip.KGSM.Monitor</RootNamespace>
    <AssemblyName>kgsm-monitor</AssemblyName>

    <!-- Required by the source-generated [LibraryImport] sysconf(_SC_CLK_TCK) p/invoke in
         ProcTreeSampler (Slice 3). The generated marshalling stub uses unsafe; no hand-written
         unsafe code in the project. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internal pure parse/rate helpers + Build() to test and benchmark projects. -->
    <InternalsVisibleTo Include="Monitor.Tests" />
    <InternalsVisibleTo Include="Monitor.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded for Slice 2 (per-server cgroup metrics): the single KGSM chokepoint
         (instance resync + event watch + resolution metadata). net9 lib is
         IsAotCompatible; consuming it from this net10 AOT app is a verified pattern. -->
    <ProjectReference Include="../../../kgsm-lib/kgsm-lib/kgsm-lib.csproj" />
  </ItemGroup>

</Project>
