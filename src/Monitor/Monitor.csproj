<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Native AOT: small footprint, no JIT, instant start — the daemon must not
         steal resources from the game servers it watches. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>

    <RootNamespace>TheKrystalShip.KGSM.Monitor</RootNamespace>
    <AssemblyName>kgsm-monitor</AssemblyName>
    <Version>1.4.0</Version>

    <!-- Required by the source-generated [LibraryImport] sysconf(_SC_CLK_TCK) p/invoke in
         ProcTreeSampler (Slice 3). The generated marshalling stub uses unsafe; no hand-written
         unsafe code in the project. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internal pure parse/rate helpers + Build() to test and benchmark projects. -->
    <InternalsVisibleTo Include="Monitor.Tests" />
    <InternalsVisibleTo Include="Monitor.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <!-- The daemon's settings file, renamed from appsettings.json so it can't collide with a sibling
         ecosystem service's config if they ever share a directory. The Web SDK only auto-copies the
         literal "appsettings.json", so the renamed file needs an explicit item to reach bin/ + publish/.
         Program.cs loads it from AppContext.BaseDirectory; deploy installs it beside the binary. -->
    <Content Update="kgsm-monitor.settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared GET /metrics wire contract (Snapshot graph + source-gen JSON). The
         monitor owns the shape and references it by project so a contract change is a
         compile break here; the same source is packed and consumed by kgsm-api. -->
    <ProjectReference Include="..\Monitor.Contracts\Monitor.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The single KGSM chokepoint (instance resync + event watch + resolution
         metadata) for Slice 2 per-server cgroup metrics. Consumed as the published
         NuGet package; the net9 lib is IsAotCompatible, so consuming it from this
         net10 AOT app is a verified pattern.
         Pinned to 1.22.0: 1.5.0 modelled Instance.ports as an opaque STRING, but
         kgsm now emits the structured `ports` array ([{start,end,protocol}], the
         canonical-port-format break at lib 1.10.0). On the old pin the per-server
         resync threw on the detailed instance-list JSON ("StartArray as string"),
         the watch-list stayed empty, and `servers` was permanently []. 1.22.0 also
         carries Instance.CgroupPath (native cgroup addressing) the resolver needs. -->
    <PackageReference Include="TheKrystalShip.KGSM.Lib" Version="1.28.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Raw ADO SQLite for the metrics-history store (the monitor is the single source of truth for
         history). Microsoft.Data.Sqlite (NOT EF Core — EF is not AOT-safe) bundles the e_sqlite3 native
         lib via SQLitePCLRaw.bundle_e_sqlite3, which the AOT publish emits alongside the binary. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
  </ItemGroup>

  <!-- Scoped NuGet-audit suppression (NOT a blanket NuGetAudit=off): GHSA-2m69-gcr7-jv3q is an
       advisory on the native SQLite lib pulled TRANSITIVELY by Microsoft.Data.Sqlite
       (SQLitePCLRaw.lib.e_sqlite3 2.1.11) — the latest published build of that native lib, no fixed
       version to move to yet. Exposure is minimal: SQLite stores only this host's local metrics history
       on a trusted host (no untrusted SQL, no network DB). DELETE this when a patched bundle ships. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

  <Target Name="SetSourceRevisionId" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;CoreCompile"
          Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; rev-parse --short=12 HEAD"
          ConsoleToMSBuild="true" ContinueOnError="true" StandardErrorImportance="low" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitShortSha" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(_GitExitCode)' == '0' and '$(_GitShortSha)' != ''">
      <SourceRevisionId>$(_GitShortSha)</SourceRevisionId>
    </PropertyGroup>
  </Target>

</Project>
